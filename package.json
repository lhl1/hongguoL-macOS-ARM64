{
  "name": "hongguo-desktop",
  "version": "2.3.4",
  "private": true,
  "description": "Independent Electron short-drama client for macOS Apple Silicon, based on the verified .13 playback chain",
  "author": "lhl1",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/check-runtime.mjs && npm run build && electron .",
    "test": "node --test tests/*.test.mjs",
    "test:live": "node scripts/check-runtime.mjs && node scripts/native-live-check.mjs",
    "test:desktop": "node scripts/check-runtime.mjs && npm run build && electron . --smoke-test",
    "pack": "node scripts/build-macos.mjs",
    "prepare:mac": "node scripts/run-python.mjs scripts/prepare-runtime-macos.py",
    "pack:mac": "node scripts/build-macos.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "8.3.3",
    "electron": "44.6.0",
    "electron-builder": "26.15.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lhl1/hongguoL-macOS-ARM64.git"
  }
}
